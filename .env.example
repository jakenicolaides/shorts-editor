# Local pipeline config (copy to .env)
# Optional: when empty, the key set in the posting app's Settings is used.
ANTHROPIC_API_KEY=
# Archive root: finals go to <root>/twixtle/Dailies or <root>/vowelsweeper. Leave empty on a Mac
# with no Dropbox (the posting app keeps the copy that gets posted); Jake's is
# /Users/<you>/Library/CloudStorage/Dropbox and is found on its own when it exists.
ARCHIVE_DIR=

# The posting app. Mint a token per computer in its Settings > Editor token.
# Leave both out and approve only saves to Dropbox.
POSTER_URL=
POSTER_TOKEN=
